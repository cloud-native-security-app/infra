{
  "family": "security-app-user-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "__EXEC_ROLE_ARN__",
  "containerDefinitions": [
    {
      "name": "user-service",
      "image": "__IMG_USER_SERVICE__",
      "essential": true,
      "portMappings": [
        {"name": "user-service", "containerPort": 8080, "protocol": "tcp"}
      ],
      "environment": [
        {"name": "DATABASE_URL", "value": "postgres://postgres:devpassword@postgres:5432/usuarios"},
        {"name": "HTTP_HOST", "value": "0.0.0.0"},
        {"name": "HTTP_PORT", "value": "8080"},
        {"name": "GATEWAY_SHARED_SECRET", "value": "dev-shared-secret"},
        {"name": "CREDENTIALS_ENCRYPTION_KEY", "value": "0707070707070707070707070707070707070707070707070707070707070707"},
        {"name": "RUST_LOG", "value": "info,user_service=debug,tower_http=debug"}
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/security-app/user-service",
          "awslogs-region": "__AWS_REGION__",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
