{
  "family": "security-app-postgres",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "__EXEC_ROLE_ARN__",
  "containerDefinitions": [
    {
      "name": "postgres",
      "image": "__IMG_POSTGRES__",
      "essential": true,
      "portMappings": [
        {"name": "postgres", "containerPort": 5432, "protocol": "tcp"}
      ],
      "environment": [
        {"name": "POSTGRES_USER", "value": "postgres"},
        {"name": "POSTGRES_PASSWORD", "value": "devpassword"},
        {"name": "POSTGRES_DB", "value": "usuarios"}
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "pg_isready -U postgres"],
        "interval": 15,
        "timeout": 5,
        "retries": 10,
        "startPeriod": 10
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/security-app/postgres",
          "awslogs-region": "__AWS_REGION__",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
