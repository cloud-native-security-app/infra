{
  "family": "security-app-rabbitmq",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "__EXEC_ROLE_ARN__",
  "containerDefinitions": [
    {
      "name": "rabbitmq",
      "image": "__IMG_RABBITMQ__",
      "essential": true,
      "portMappings": [
        {
          "name": "rabbitmq-amqp",
          "containerPort": 5672,
          "protocol": "tcp"
        },
        {
          "name": "rabbitmq-amqps",
          "containerPort": 5671,
          "protocol": "tcp"
        },
        {
          "name": "rabbitmq-mgmt",
          "containerPort": 15672,
          "protocol": "tcp"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "bash -c '</dev/tcp/127.0.0.1/5672 && </dev/tcp/127.0.0.1/5671'"
        ],
        "interval": 15,
        "timeout": 5,
        "retries": 10,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/security-app/rabbitmq",
          "awslogs-region": "__AWS_REGION__",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "taskRoleArn": "__EXEC_ROLE_ARN__"
}
