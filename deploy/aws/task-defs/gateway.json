{
  "family": "security-app-gateway",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "__EXEC_ROLE_ARN__",
  "containerDefinitions": [
    {
      "name": "gateway",
      "image": "__IMG_GATEWAY__",
      "essential": true,
      "portMappings": [
        {"name": "gateway", "containerPort": 8080, "protocol": "tcp"}
      ],
      "environment": [
        {"name": "HTTP_HOST", "value": "0.0.0.0"},
        {"name": "HTTP_PORT", "value": "8080"},
        {"name": "GOOGLE_CLIENT_ID", "value": "dev-placeholder"},
        {"name": "GOOGLE_CLIENT_SECRET", "value": "dev-placeholder"},
        {"name": "GOOGLE_REDIRECT_URI", "value": "__GATEWAY_PUBLIC_URL__/auth/callback"},
        {"name": "FRONT_BASE_URL", "value": "__FRONT_PUBLIC_URL__"},
        {"name": "SESSION_SIGNING_KEY", "value": "dev-signing-key-not-for-prod"},
        {"name": "SESSION_TTL_SECS", "value": "3600"},
        {"name": "BROKER_AMQPS_URL", "value": "amqp://gateway:lab-only-not-a-real-secret-gateway@rabbitmq:5672"},
        {"name": "BROKER_VHOST", "value": "security-app"},
        {"name": "MS_USUARIOS_BASE_URL", "value": "http://user-service:8080"},
        {"name": "MS_USUARIOS_SHARED_SECRET", "value": "dev-shared-secret"},
        {"name": "SCAN_SUBMISSION_RATE_LIMIT_MAX_REQUESTS", "value": "5"},
        {"name": "SCAN_SUBMISSION_RATE_LIMIT_WINDOW_SECS", "value": "60"}
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/security-app/gateway",
          "awslogs-region": "__AWS_REGION__",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
